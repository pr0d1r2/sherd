#!/usr/bin/env bash
# Same rule as pre-commit, one hook later: `hk.pkl`'s `pre-push` set.
#
# It exists because `commit` and `push` are separate events and this repo has
# been burned by treating them as one: B17 chained `commit && push` where the
# commit ABORTED and the push shipped the OLD head, then B20 repeated it three
# hours after recording it. A push-side gate checks the thing actually being
# published, whatever the commit did.
set -e

if ! command -v hk >/dev/null 2>&1; then
  echo "" >&2
  echo "pre-push REFUSED: hk is not on PATH -- refusing to pass unverified" >&2
  echo "  fix: \`direnv allow\`, or \`nix develop\`, then push from that shell." >&2
  echo "       A gate that cannot RUN has not passed (tdd V26)." >&2
  echo "" >&2
  echo "  Never \`--no-verify\`. The gate refusing is the system working." >&2
  exit 1
fi

# A TAG PUSH IS NOT A CODE PUSH, and hk cannot read one (`.:B27`).
#
# git hands this hook `<local ref> <local sha> <remote ref> <remote sha>` on
# stdin. For a tag it supplies the ANNOTATED TAG OBJECT's sha, not a commit,
# and hk 1.55.0 feeds that straight into a merge-base computation without
# peeling it: `object is no commit object`, at hk's own src/git.rs:1678. So
# `cargo release push` could not push a tag at all -- the release stopped one
# step from done, twice.
#
# The rule: a push carrying ONLY tags, each already reachable from the remote
# trunk, has nothing new to gate. That commit passed this hook when it was
# pushed and passed CI on the branch that merged it. A tag is a pointer to it.
#
# This is a SKIP with a precondition, not a bypass. A tag pointing at a commit
# the trunk does not contain is exactly the case worth stopping, so it falls
# through to the gate. Any branch ref in the same push does too.
refs=$(cat)

only_tags=1
have_ref=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_ref" ] || continue
  have_ref=1
  case "$local_ref" in
  refs/tags/*) ;;
  *)
    only_tags=0
    ;;
  esac
  # A deletion sends an all-zero local sha and has no object to peel.
  case "$local_sha" in
  *[!0]*) ;;
  *) continue ;;
  esac
  # `^{commit}` peels an annotated tag to what it points at. If that commit
  # is not on the remote trunk, this push is publishing something the gate
  # has not seen.
  if ! commit=$(git rev-parse --quiet --verify "${local_sha}^{commit}"); then
    only_tags=0
  elif ! git merge-base --is-ancestor "$commit" refs/remotes/origin/main; then
    only_tags=0
  fi
done <<EOF
$refs
EOF

if [ "$have_ref" = 1 ] && [ "$only_tags" = 1 ]; then
  echo "pre-push: tags only, each already on origin/main -- gate skipped." >&2
  exit 0
fi

printf '%s\n' "$refs" | exec hk run pre-push --from-hook "$@"

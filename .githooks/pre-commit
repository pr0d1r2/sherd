#!/usr/bin/env bash
# The gate, delegated to hk. The OPS live in `hk.pkl`; this file only decides
# that they must run. Read by agents as much as by humans: the refusal below
# says what to RUN to fix it, because a rejection an agent cannot act on gets
# worked around, and the way it gets worked around is `--no-verify`.
#
# A TRACKED file, not one generated into `.git/hooks` by the dev shell, because
# `core.hooksPath` already points here and a hook you can read in a diff is a
# hook a reviewer can check.
#
# It REFUSES when hk is absent; it does not skip. The siblings skip loudly and
# that is right for them -- their CI gates regardless. sherd has no CI yet,
# so these hooks ARE the gate of record, and V26 is explicit: a gate that
# cannot run has NOT passed. B17, B20 and B24 are three recordings of that one
# failure shape, twice reported as green.
set -e

if ! command -v hk >/dev/null 2>&1; then
  echo "" >&2
  echo "pre-commit REFUSED: hk is not on PATH -- refusing to pass unverified" >&2
  echo "  fix: \`direnv allow\`, or \`nix develop\`, then commit from that shell." >&2
  echo "       hk comes from the nix-hk input; nixos-26.05 ships no hk of its own." >&2
  echo "       A gate that cannot RUN has not passed (tdd V26)." >&2
  echo "" >&2
  echo "  Never \`--no-verify\`. The gate refusing is the system working." >&2
  echo "  Never weaken a test, raise a ceiling, or loosen a judge to pass." >&2
  exit 1
fi

exec hk run pre-commit --from-hook "$@"

/// blackbox's gate, defined ONCE.
///
/// Every op below is a plain cargo command a human can paste into a shell. hk
/// decides *when* they run -- which files changed, which hook, in what order --
/// and never hides *what* runs, so a verdict never rests on the runner's own
/// logic.
///
/// This file REPLACED a hand-written `.githooks/pre-commit` that ran the same
/// ops unconditionally. What it buys: the ops are now reachable from CI and by
/// hand (`hk check`), they are file-scoped so a SPEC-only commit skips the
/// compile, and the fix half (`cargo fmt`) is declared next to the check half
/// instead of living in a refusal message.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time: the gate must run with no network, because a
/// gate that needs one is a gate that goes soft on a plane.
amends "pkl/Config.pkl"

/// Success is silence. Output that always appears is output nobody reads,
/// which is how a real failure hides in noise everyone learned to scroll past.
///
/// `fail_fast` locally because the loop is cheap, so the FIRST failure is the
/// most useful thing to surface, and `depends` orders steps cheapest-first so
/// it arrives fast.
fail_fast = true

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// `depends` chains the cargo steps deliberately. Cargo takes a lock on the
/// target directory, so two cargo jobs launched in parallel do not run in
/// parallel -- the second blocks on "Blocking waiting for file lock on build
/// directory", which READS AS A HANG.
local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  // `-D warnings` is passed AFTER `--`, so it applies to this crate and not to
  // `../itok`. RUSTFLAGS was the old hook's way and it reached every path dep:
  // itok landing two `dead_code` warnings of its own turned blackbox's gate red
  // for code blackbox does not own.
  // `-D warnings` still holds for everything EXCEPT the thirteen lints under
  // ratchet. Those are allowed HERE and counted by `lint-debt` below, because
  // a tree with 290 pre-existing violations cannot compile under `-D` and
  // could not even be measured. Every other warning stays fatal.
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = "cargo clippy --workspace --all-targets -- -D warnings -A clippy::too_many_lines -A clippy::cognitive_complexity -A clippy::excessive_nesting -A clippy::fn_params_excessive_bools -A clippy::struct_excessive_bools -A clippy::unwrap_used -A clippy::expect_used -A clippy::panic -A clippy::indexing_slicing -A clippy::arithmetic_side_effects -A clippy::todo -A clippy::unimplemented -A clippy::dbg_macro -A clippy::too_many_arguments -A clippy::type_complexity"
  }
  // THE RATCHET. The count may fall, never rise. `.lint-debt` carries the
  // number and the reasoning; `clippy.toml` carries the thresholds.
  ["lint-debt"] {
    glob = List("**/*.rs", "clippy.toml", ".lint-debt")
    depends = List("clippy")
    check = """
      now=$(cargo clippy --workspace --all-targets --message-format=short 2>&1 | grep -cE '^(src|dev)/.*: warning')
      was=$(awk '/^total /{print $2}' .lint-debt)
      [ "$now" -le "$was" ] || { echo "hk: lint debt ROSE, $was -> $now. The limits in clippy.toml are the shape the target model handles (.:R44); adding to the debt walks away from the §G TARGET. Fix the new sites, or record WHY in .lint-debt with the raise." >&2; exit 1; }
      [ "$now" -eq "$was" ] || echo "hk: lint debt fell $was -> $now. Run: hk run fix"
      """
    // `fix` may only LOWER. `pre-commit` runs the fast set in fix mode, so a
    // fix that recorded whatever it measured would file down the ratchet's
    // own teeth on every commit -- it would write the raise it exists to
    // refuse, and the gate would never fail twice for the same debt.
    //
    // Caught exactly that way: the cli coverage tests added one violation,
    // `hk check --all` refused, and this step then rewrote 274 to 275 behind
    // the commit.
    fix = """
      now=$(cargo clippy --workspace --all-targets --message-format=short 2>&1 | grep -cE '^(src|dev)/.*: warning')
      was=$(awk '/^total /{print $2}' .lint-debt)
      [ "$now" -le "$was" ] || { echo "hk: refusing to RECORD a raise, $was -> $now. A ratchet that writes down whatever it measures is not a ratchet. Fix the new sites, or edit .lint-debt by hand with the reason." >&2; exit 1; }
      awk -v n="$now" '/^total /{print "total " n; next} {print}' .lint-debt > .lint-debt.new
      mv .lint-debt.new .lint-debt
      """
  }
  ["test"] {
    // SPEC.md and every node's SPEC.md are inputs: `src/spec`, `src/fed` and
    // `src/lens` tests READ them, and `src/lib.rs` reads `Cargo.toml`. A step's
    // glob must name every input its tests read, not just the language they are
    // written in -- else a spec-only commit skips the tests whose whole subject
    // is the spec.
    glob = List("**/*.rs", "**/SPEC.md", "Cargo.toml", ".context-limits")
    depends = List("clippy")
    check = "cargo test --workspace"
  }
  // THE DOGFOOD. blackbox checks its own federated spec with the binary being
  // built, so a rule this repo cannot pass is a rule it cannot ship.
  //
  // `cargo run` rather than `./target/debug/bbx`: `cargo test` does NOT refresh
  // the binary, so the path form gates a stale build (`src/tdd:B3`).
  ["slice"] {
    glob = List("**/*.rs", "**/SPEC.md", ".bbx-slices")
    depends = List("test")
    check = "cargo run -q --bin bbx -- slice --check || { echo 'hk: a distilled slice has drifted from its source. Run `bbx slice` to regenerate, then `git add` the result. Never hand-edit a generated slice -- that IS the drift.' >&2; exit 1; }"
    fix = "cargo run -q --bin bbx -- slice"
  }
  ["check"] {
    glob = List("**/*.rs", "**/SPEC.md", ".spec-records")
    depends = List("slice")
    check = "cargo run -q --bin bbx -- check || { echo 'hk: bbx check found a structural violation -- it names the file, line and rule. Ids are monotonic and never reused: COMPUTE the next one, do not read `tail -1`. Rows sort by id within a section, so append IN ORDER.' >&2; exit 1; }"
  }
  // V104: a declared limit needs a runner that EXITS NONZERO. `.context-limits`
  // sat unread from the first commit, and by the time T10 built the comparison
  // every one of thirteen chains was over (B7). A runner that lives only in a
  // command someone remembers to type is the same defect one step later.
  //
  // The glob is SPEC.md and the limits file, NOT `**/*.rs`: a chain is built
  // from spec files, so a code-only commit cannot move a budget. Naming the
  // inputs a step actually reads is V57.
  ["budget"] {
    glob = List("**/SPEC.md", ".context-limits")
    depends = List("check")
    check = "cargo run -q --bin bbx -- budget || { echo 'hk: a chain is over its ceiling. Every chain pays ROOT, so a row added to the root SPEC.md is billed thirteen times. SPLIT or federate the spec (V50) -- raising the number trains the reflex instead of catching the problem, and a raise belongs in a commit with its reason.' >&2; exit 1; }"
  }

  // T87. The hygiene family the siblings run and this repo did not. NO new
  // dependency: `hk util` is the runner already on PATH, so the whole set
  // costs a closure of nothing.
  //
  // MEASURED before landing, across every tracked file: zero findings, all
  // nine. That number alone would be worthless -- a check that finds nothing
  // and a check that cannot find anything read identically, which is the
  // vacuous pass V16 is about. So each was also run against a PLANTED
  // violation in a scratch tree, and eight of nine rejected it.
  //
  // The ninth is why `--assume-in-merge` is here: without that flag
  // `check-merge-conflict` silently passes a file carrying real `<<<<<<<`
  // markers, because it only looks when git says a merge is in progress.
  // The flag was copied from microlith's version and then TESTED rather
  // than trusted, which is the only reason this comment can name what it
  // does. `check-added-large-files` accepted a 2 MB file at its default
  // limit -- it fires, above some threshold we have not needed to find.
  //
  // Read-only checks run over everything. The three FIXERS exclude `pkl/`
  // and `vendor/`: both are other people's files vendored verbatim, and a
  // fixer that rewrites them makes them no longer the thing that was
  // vendored -- `docs/THIRD-PARTY-NOTICES.md` says what they are, and a
  // whitespace edit would quietly make that false.
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "hk util check-merge-conflict --assume-in-merge {{files}}"
  }
  // Irreversible if it ever fires late: a key in git history stays in git
  // history, and this repo is being prepared for publication.
  ["no-private-key"] {
    glob = List("**/*")
    check = "hk util detect-private-key {{files}}"
  }
  ["no-large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "hk util check-byte-order-marker {{files}}"
  }
  // A crate that ships to case-insensitive filesystems cannot afford two
  // paths differing only in case -- and the machine that would notice is
  // never the one that committed them.
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "hk util check-case-conflict {{files}}"
  }
  ["no-broken-symlinks"] {
    glob = List("**/*")
    check = "hk util check-symlinks {{files}}"
  }
  ["trailing-whitespace"] {
    glob = List("**/*")
    exclude = List("pkl/**", "vendor/**")
    check_diff = "hk util trailing-whitespace --diff {{files}}"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    exclude = List("pkl/**", "vendor/**")
    check_diff = "hk util end-of-file-fixer --diff {{files}}"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    exclude = List("pkl/**", "vendor/**")
    check_diff = "hk util mixed-line-ending --diff {{files}}"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }

  // Below this line the steps need a REAL BINARY, unlike the `hk util`
  // family above. Each is pinned in the dev shell and reached from CI
  // through that same shell, so there is one version rather than two.
  //
  // Every one of them opens with a `command -v` guard, and that is not
  // decoration: the first commit after this set landed died on `sh: line
  // 1: nixfmt: command not found`, because a shell entered before the
  // flake changed does not have the new tools. Without the guard a MISSING
  // TOOL reports as a step failure, which reads as a finding about the
  // code -- `.:B6`'s shape, a verdict that names the wrong thing. With it
  // the message says what actually happened and what to do about it.
  //
  // Each landed with its findings MEASURED, and two of the six found
  // something the moment they were pointed at the tree: `flake.nix` had
  // never been formatted, and three doc comments carried a spelling the dictionary rejects.
  // Both had been in the tree since the file was written, seen by every
  // reader and caught by nothing -- which is the argument for the steps
  // rather than for the fixes.

  // The workflow is code, and it is the one file no local run exercises:
  // a mistake in it is found by pushing, and its failure mode is a run
  // that never starts.
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "command -v actionlint >/dev/null 2>&1 || { echo 'hk: actionlint is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; actionlint {{files}}"
  }
  // `.envrc` is shell without a `.sh` name, and it runs on every shell
  // entry -- exactly where a silent mistake costs most.
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash", ".envrc")
    check = "command -v shellcheck >/dev/null 2>&1 || { echo 'hk: shellcheck is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; shellcheck --shell=bash {{files}}"
  }
  // The flake is the toolchain definition: it decides what every other
  // step runs with, so drift here is drift everywhere. It arrived
  // UNFORMATTED, so the fix half is declared -- but `nixfmt` reflows the
  // hand-written comment blocks this file is mostly made of, so it is run
  // deliberately (`hk fix`) rather than on every commit.
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "command -v nixfmt >/dev/null 2>&1 || { echo 'hk: nixfmt is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; nixfmt --check {{files}}"
    fix = "command -v nixfmt >/dev/null 2>&1 || { echo 'hk: nixfmt is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; nixfmt {{files}}"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    exclude = List("pkl/**")
    check = "command -v taplo >/dev/null 2>&1 || { echo 'hk: taplo is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; taplo format --check --diff {{files}}"
    fix = "command -v taplo >/dev/null 2>&1 || { echo 'hk: taplo is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; taplo format {{files}}"
  }
  // `--force-exclude`, because `.typos.toml`'s excludes are ignored for
  // paths passed explicitly and hk always passes them explicitly. Without
  // it the vendored schema and the vendored principles get scanned, and
  // the step reports someone else's spelling as our finding.
  ["typos"] {
    glob = List("**/*")
    check = "command -v typos >/dev/null 2>&1 || { echo 'hk: typos is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; typos --force-exclude {{files}}"
    fix = "command -v typos >/dev/null 2>&1 || { echo 'hk: typos is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; typos --force-exclude --write-changes {{files}}"
  }
  // OFFLINE ONLY. Relative paths are the half that breaks when a file
  // moves and the half no other step can see; external URLs need the
  // network this gate refuses, and a 404 on someone else's site is not a
  // reason to reject a commit.
  //
  // Checks EVERY document, ignoring {{files}} deliberately. A link breaks
  // when its TARGET moves, and the target's referrer is usually not in the
  // changed set -- scoping this to changed files would make it pass on
  // exactly the commit that breaks the link.
  // The badge block is GENERATED, by `bbx-dev` rather than by a shell
  // script. A number typed into prose is true the day it is typed and
  // quietly wrong after -- `.:B4` in a README instead of a commit message --
  // and the generator that prevents it is itself code, so it is gated,
  // typed and unit-tested like everything else here. The first draft WAS a
  // shell script, and it had two parser defects within ten minutes of
  // existing; `dev/SPEC.md:V4` is one of them, kept as a test.
  ["readme-generated"] {
    glob = List("README.md", "dev/src/**", "Cargo.toml", "hk.pkl", ".coverage", ".lint-debt", "flake.lock", ".github/workflows/ci.yml", "**/SPEC.md")
    depends = List("test")
    check = "cargo run -q -p bbx-dev -- --check {{files}}"
    fix = "cargo run -q -p bbx-dev -- readme {{files}}"
  }
  ["links"] {
    glob = List("**/*")
    check = "command -v lychee >/dev/null 2>&1 || { echo 'hk: lychee is not on PATH -- re-enter the dev shell (`nix develop`, or `direnv reload`). This is a MISSING TOOL, not a finding.' >&2; exit 1; }; lychee --offline --no-progress . || { echo 'hk: a relative link does not resolve. Fix the path, or the file it points at.' >&2; exit 1; }"
  }
}

/// One set today. `all` exists as the name CI and pre-push use, so adding an
/// expensive axis later (coverage, a matrix) changes this file and nothing that
/// calls it.
local all = (fast) {
  // LAYER TWO. The step above is scoped: `hk` hands it the changed files and
  // `bbx-dev` narrows to the blocks those files are inputs to, so a commit
  // touching `.coverage` compares the badges and not the diagram. That map
  // is a HEURISTIC, and a heuristic that is too narrow lets a stale block
  // through -- so the same checker runs again on push with NO scope, where
  // every block is compared against its owners. Cheap and approximate at the
  // near end, complete at the far one.
  //
  // `**/*` deliberately: this layer must run whatever changed, including a
  // commit that changed nothing the narrow glob names.
  ["readme-generated-full"] {
    glob = List("**/*")
    depends = List("test")
    check = "cargo run -q -p bbx-dev -- --check"
    fix = "cargo run -q -p bbx-dev -- readme"
  }

  // Coverage is ~60s, so it runs on PUSH and in `hk check`, never on commit:
  // a hook you are tempted to bypass is worse than no hook.
  //
  // Ratcheted like `.lint-debt`, and for the same reason. Measured 64.76% at
  // adoption against a 98% destination, so a hard floor would gate every
  // commit red for weeks -- `.:B6` is what happens to a gate nobody can pay.
  ["coverage"] {
    glob = List("**/*.rs", ".coverage")
    depends = List("budget")
    check = """
      out=$(cargo llvm-cov --workspace --summary-only 2>&1) || { echo "$out" >&2; exit 1; }
      now=$(printf '%s' "$out" | awk '/^TOTAL/{gsub("%","",$10); print $10}')
      was=$(awk '/^lines /{print $2}' .coverage)
      [ -n "$now" ] || { echo 'hk: could not read a coverage total -- that is an ERROR, not a floor breach (.:tdd:V26)' >&2; exit 1; }
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 < w+0)}' && { echo "hk: coverage FELL, $was% -> $now%. A line that stopped being covered is a test that stopped asserting. Cover it, or say why in .coverage with the drop." >&2; exit 1; }
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 > w+0)}' && echo "hk: coverage rose $was% -> $now%. Run: hk run fix"
      printf 'coverage %s%% (floor %s%%)\\n' "$now" "$was"
      """
    // Same rule as `lint-debt`, mirrored: this one may only RAISE.
    fix = """
      out=$(cargo llvm-cov --workspace --summary-only 2>&1) || { echo "$out" >&2; exit 1; }
      now=$(printf '%s' "$out" | awk '/^TOTAL/{gsub("%","",$10); print $10}')
      was=$(awk '/^lines /{print $2}' .coverage)
      [ -n "$now" ] || exit 1
      awk -v n="$now" -v w="$was" 'BEGIN{exit !(n+0 < w+0)}' && { echo "hk: refusing to RECORD a drop, $was% -> $now%. Cover the gap, or edit .coverage by hand with the reason." >&2; exit 1; }
      awk -v n="$now" '/^lines /{print "lines " n; next} {print}' .coverage > .coverage.new
      mv .coverage.new .coverage
      """
  }
}

hooks {
  /// `stash = "git"` is correctness, not speed -- without it a partially staged
  /// file (`git add -p`) is checked as it looks in the WORKTREE, giving a
  /// verdict about code you are not committing.
  ///
  /// The hooks in `.githooks/` are TRACKED FILES, not generated ones, and they
  /// REFUSE when hk is missing rather than skipping. blackbox's own V26 says a
  /// gate that cannot run has not passed, and B17/B20/B24 are three recordings
  /// of that exact failure shape.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = all
  }
  /// What `hk check` runs -- the entry point for CI and for a by-hand full run.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
